# FloatClock application rules. Dependency rules are generated by KeepKit.

# Kotlin annotations and generic metadata used by Compose and serialization.
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod,AnnotationDefault
-keep class kotlin.Metadata { *; }

# @file:JvmName("FloatClock") defines the application entry point.
-keepclassmembers class top.ntutn.floatclock.FloatClock {
    public static void main(java.lang.String[]);
}

# The macOS bridge is looked up by its fixed JNI class and method names.
-keep class top.ntutn.floatclock.macos.MacOSWindowBridge { *; }
-keepclasseswithmembernames class * {
    native <methods>;
}

# Compose 1.8.2 compatibility: avoid collisions between obfuscated internal fields.
# Names are preserved while unreachable classes and members can still be removed.
-keepnames class androidx.compose.** { *; }

# Optional references from the project's Compose / Kotlin versions.
-dontwarn android.annotation.SuppressLint
-dontwarn org.codehaus.mojo.animal_sniffer.IgnoreJRERequirement
-dontwarn org.graalvm.compiler.core.aarch64.AArch64NodeMatchRules_MatchStatementSet*
-dontwarn kotlin.concurrent.atomics.**
-dontwarn kotlin.jvm.internal.EnhancedNullability
